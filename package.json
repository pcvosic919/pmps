{
  "name": "dispatch-system",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:local": "pnpm -r --parallel dev:local",
    "build": "pnpm -r build",
    "start": "node server/dist/server/index.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:local": "pnpm -r --parallel test:local",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:local": "tsx scripts/seed-demo.ts",
    "lint": "pnpm -r lint",
    "db:prepare": "tsx scripts/prepare-db.ts",
    "audit:opportunity-conversions": "tsx scripts/audit-opportunity-conversions.ts",
    "migrate:business-flow-foundation": "tsx scripts/migrate-business-flow-foundation.ts",
    "audit:assignment-integrity": "tsx scripts/audit-assignment-integrity.ts",
    "migrate:recognition-and-products": "tsx scripts/migrate-recognition-and-product-approvals.ts",
    "migrate:opportunity-quote-project-flow": "tsx scripts/migrate-opportunity-quote-project-flow.ts",
    "cosmos:shared-throughput": "bash scripts/prepare-cosmos-shared-throughput.sh"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "packageManager": "pnpm@10.28.1"
