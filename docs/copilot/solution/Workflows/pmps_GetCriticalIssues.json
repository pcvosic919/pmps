{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "PMPS_BASE_URL": { "type": "string", "defaultValue": "https://cl5kqbhd-5000.asse.devtunnels.ms/api/v1" },
        "PMPS_API_KEY":  { "type": "string", "defaultValue": "pmp_r9xby7l6guh" }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerVirtualAgents",
          "inputs": {
            "schema": { "type": "object", "properties": {} }
          }
        }
      },
      "actions": {
        "Get_Critical_Issues": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('PMPS_BASE_URL')}/issues/critical?limit=10",
            "headers": { "X-API-KEY": "@{parameters('PMPS_API_KEY')}" }
          },
          "runAfter": {}
        },
        "Parse_Response": {
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Critical_Issues')",
            "schema": {
              "type": "object",
              "properties": {
                "count": { "type": "integer" },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "issueTitle":          { "type": "string" },
                      "severity":            { "type": "string" },
                      "currentStatus":       { "type": "string" },
                      "affectedProjectName": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "runAfter": { "Get_Critical_Issues": ["Succeeded"] }
        },
        "Check_Issues": {
          "type": "If",
          "expression": { "equals": ["@body('Parse_Response')?['count']", 0] },
          "actions": {
            "Respond_NoIssues": {
              "type": "Response",
              "kind": "PowerVirtualAgents",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "issueCount": 0,
                  "message": "目前沒有嚴重或高優先度的議題，所有專案運作正常。"
                },
                "responseSchema": {
                  "type": "object",
                  "properties": {
                    "issueCount": { "type": "integer" },
                    "message":    { "type": "string" }
                  }
                }
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Select_Issue_Lines": {
                "type": "Select",
                "inputs": {
                  "from": "@body('Parse_Response')?['data']",
                  "select": "• @{item()?['affectedProjectName']}：@{item()?['issueTitle']} [@{item()?['severity']}]"
                },
                "runAfter": {}
              },
              "Join_Issues": {
                "type": "Join",
                "inputs": {
                  "from": "@body('Select_Issue_Lines')",
                  "joinWith": "\n"
                },
                "runAfter": { "Select_Issue_Lines": ["Succeeded"] }
              },
              "Respond_Issues": {
                "type": "Response",
                "kind": "PowerVirtualAgents",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "issueCount": "@{body('Parse_Response')?['count']}",
                    "issueList":  "@{body('Join_Issues')}",
                    "message":    "目前有 @{body('Parse_Response')?['count']} 個嚴重議題：\n@{body('Join_Issues')}"
                  },
                  "responseSchema": {
                    "type": "object",
                    "properties": {
                      "issueCount": { "type": "integer" },
                      "issueList":  { "type": "string" },
                      "message":    { "type": "string" }
                    }
                  }
                },
                "runAfter": { "Join_Issues": ["Succeeded"] }
              }
            }
          },
          "runAfter": { "Parse_Response": ["Succeeded"] }
        }
      },
      "outputs": {}
    },
    "displayName": "PMPS - 查詢高風險議題",
    "description": "取得所有高/嚴重優先度的未解決議題，供 Copilot Studio 呼叫。"
  }
}



