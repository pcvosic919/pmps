{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "PMPS_BASE_URL": { "type": "string", "defaultValue": "https://cl5kqbhd-5000.asse.devtunnels.ms/api/v1" },
        "PMPS_API_KEY":  { "type": "string", "defaultValue": "pmp_r9xby7l6guh" }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerVirtualAgents",
          "inputs": {
            "schema": { "type": "object", "properties": {} }
          }
        }
      },
      "actions": {
        "Get_Won_Opportunities": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('PMPS_BASE_URL')}/opportunities/won?limit=5",
            "headers": { "X-API-KEY": "@{parameters('PMPS_API_KEY')}" }
          },
          "runAfter": {}
        },
        "Parse_Response": {
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Won_Opportunities')",
            "schema": {
              "type": "object",
              "properties": {
                "count": { "type": "integer" },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "opportunityName": { "type": "string" },
                      "customerName":    { "type": "string" },
                      "dealValue":       { "type": "number" },
                      "owner":           { "type": "string" },
                      "closeDate":       { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "runAfter": { "Get_Won_Opportunities": ["Succeeded"] }
        },
        "Check_Results": {
          "type": "If",
          "expression": { "equals": ["@body('Parse_Response')?['count']", 0] },
          "actions": {
            "Respond_None": {
              "type": "Response",
              "kind": "PowerVirtualAgents",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "count":   0,
                  "message": "目前尚無成交的商機記錄。"
                },
                "responseSchema": {
                  "type": "object",
                  "properties": {
                    "count":   { "type": "integer" },
                    "message": { "type": "string" }
                  }
                }
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Select_Opp_Lines": {
                "type": "Select",
                "inputs": {
                  "from": "@body('Parse_Response')?['data']",
                  "select": "• @{item()?['opportunityName']}（@{item()?['customerName']}）合約金額：@{item()?['dealValue']}"
                },
                "runAfter": {}
              },
              "Join_Opps": {
                "type": "Join",
                "inputs": {
                  "from": "@body('Select_Opp_Lines')",
                  "joinWith": "\n"
                },
                "runAfter": { "Select_Opp_Lines": ["Succeeded"] }
              },
              "Respond_Opps": {
                "type": "Response",
                "kind": "PowerVirtualAgents",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "count":   "@{body('Parse_Response')?['count']}",
                    "list":    "@{body('Join_Opps')}",
                    "message": "最近成交的商機（前5筆）：\n@{body('Join_Opps')}"
                  },
                  "responseSchema": {
                    "type": "object",
                    "properties": {
                      "count":   { "type": "integer" },
                      "list":    { "type": "string" },
                      "message": { "type": "string" }
                    }
                  }
                },
                "runAfter": { "Join_Opps": ["Succeeded"] }
              }
            }
          },
          "runAfter": { "Parse_Response": ["Succeeded"] }
        }
      },
      "outputs": {}
    },
    "displayName": "PMPS - 查詢成交商機",
    "description": "取得最近成交的商機列表，供 Copilot Studio 呼叫。"
  }
}



