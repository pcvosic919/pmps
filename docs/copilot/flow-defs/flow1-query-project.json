{
  "name": "e7a8b9c0-1234-5678-abcd-ef0123456701",
  "id": "/providers/Microsoft.ProcessSimple/flows/e7a8b9c0-1234-5678-abcd-ef0123456701",
  "type": "Microsoft.ProcessSimple/flows",
  "properties": {
    "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
    "displayName": "PMPS - 查詢專案狀態",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "PMPS_BASE_URL": { "type": "string", "defaultValue": "PMPS_BASE_URL_PLACEHOLDER" },
        "PMPS_API_KEY":  { "type": "string", "defaultValue": "PMPS_API_KEY_PLACEHOLDER" }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerVirtualAgents",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "keyword": {
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "專案名稱關鍵字",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": ["keyword"]
            }
          }
        }
      },
      "actions": {
        "Search_Projects": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('PMPS_BASE_URL')}/projects/search",
            "headers": { "X-API-KEY": "@{parameters('PMPS_API_KEY')}" },
            "queries": { "q": "@{triggerBody()?['keyword']}" }
          },
          "runAfter": {}
        },
        "Parse_Response": {
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Search_Projects')",
            "schema": {
              "type": "object",
              "properties": {
                "count": { "type": "integer" },
                "message": { "type": "string" },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "projectName": { "type": "string" },
                      "status": { "type": "string" },
                      "pm": { "type": "string" },
                      "isMarginAtRisk": { "type": "boolean" },
                      "wbs": {
                        "type": "object",
                        "properties": {
                          "progressPercent": { "type": "integer" },
                          "wbsStatus": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "runAfter": { "Search_Projects": ["Succeeded"] }
        },
        "Check_Results": {
          "type": "If",
          "expression": { "equals": ["@body('Parse_Response')?['count']", 0] },
          "actions": {
            "Respond_NotFound": {
              "type": "Response",
              "kind": "PowerVirtualAgents",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "found": false,
                  "message": "找不到包含「@{triggerBody()?['keyword']}」的專案，請確認名稱後再試。"
                },
                "responseSchema": {
                  "type": "object",
                  "properties": {
                    "found": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Respond_Found": {
                "type": "Response",
                "kind": "PowerVirtualAgents",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "found": true,
                    "projectName":     "@{body('Parse_Response')?['data'][0]?['projectName']}",
                    "status":          "@{body('Parse_Response')?['data'][0]?['status']}",
                    "pm":              "@{body('Parse_Response')?['data'][0]?['pm']}",
                    "progressPercent": "@{body('Parse_Response')?['data'][0]?['wbs']?['progressPercent']}",
                    "isMarginAtRisk":  "@{body('Parse_Response')?['data'][0]?['isMarginAtRisk']}",
                    "message": "專案「@{body('Parse_Response')?['data'][0]?['projectName']}」\n狀態：@{body('Parse_Response')?['data'][0]?['status']}\nWBS 進度：@{body('Parse_Response')?['data'][0]?['wbs']?['progressPercent']}%\nPM：@{body('Parse_Response')?['data'][0]?['pm']}\n利潤風險：@{if(body('Parse_Response')?['data'][0]?['isMarginAtRisk'], '⚠️ 是', '正常')}"
                  },
                  "responseSchema": {
                    "type": "object",
                    "properties": {
                      "found": { "type": "boolean" },
                      "projectName": { "type": "string" },
                      "status": { "type": "string" },
                      "pm": { "type": "string" },
                      "progressPercent": { "type": "integer" },
                      "isMarginAtRisk": { "type": "boolean" },
                      "message": { "type": "string" }
                    }
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": { "Parse_Response": ["Succeeded"] }
        }
      },
      "outputs": {}
    },
    "state": "Started",
    "connectionReferences": {}
  }
}
